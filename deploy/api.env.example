# Generate random values; never commit the completed file. chmod 600.
JAC_DB_URL=postgresql://stack:CHANGE_ME@127.0.0.1:5432/stack
JAC_SERVE_AUTH_SECRET=CHANGE_ME_RANDOM_64_BYTES
JAC_SERVE_HOST=127.0.0.1
JAC_SERVE_DOCS=false
JAC_SERVE_GRAPH=false
JAC_SERVE_WORKERS=1
STACK_AGENT_CONFIG=/opt/stack/storage/agents/config.json
STACK_AGENT_WORKER_TOKEN=CHANGE_ME_RANDOM_48_BYTES
STACK_CONNECTION_KEY=CHANGE_ME_FERNET_KEY
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stack.example.com/oauth/google
# Register STACK_SSO_HOST/sso/google/callback separately in the SAME Google client.
# Basic identity only; Gmail/Calendar grants stay optional and separate.
STACK_SSO_HOST=https://stack.example.com
STACK_SSO_CALLBACK_URL=https://stack.example.com/auth/google
# Optional isolated browser service remains disabled.
STACK_BROWSER_URL=
STACK_BROWSER_TOKEN=
