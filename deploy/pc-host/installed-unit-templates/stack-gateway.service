[Unit]
Description=Stack private phone gateway
Wants=stack-api.service
After=stack-api.service

[Service]
Type=simple
User=stack
Group=stack
WorkingDirectory=/opt/stack
Environment=STACK_JAC_BIN=/usr/local/bin/jac
Environment=STACK_GATEWAY_BIND=127.0.0.1
Environment=STACK_GATEWAY_PORT=8080
Environment=STACK_WORKER_API=http://127.0.0.1:8000
Environment=STACK_WEB_DIST=/opt/stack/.jac/client/workspace/dist
Environment=HOME=/var/lib/stack
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/stack/scripts/jac run --no-serve scripts/gateway-service.jac
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/var/lib/stack-codex
ReadWritePaths=/opt/stack/.jac

[Install]
WantedBy=multi-user.target
