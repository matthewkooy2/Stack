[Unit]
Description=Stack single Jac writer
After=network-online.target postgresql.service

[Service]
User=stack
WorkingDirectory=/opt/stack
EnvironmentFile=/etc/stack/api.env
EnvironmentFile=-/etc/stack/worker.env
Environment=CODEX_HOME=/var/lib/stack-codex
StateDirectory=stack-codex
StateDirectoryMode=0700
Environment=STACK_JAC_BIN=/usr/local/bin/jac
ExecStart=/opt/stack/scripts/jac run --no-client --workers 1 --host 127.0.0.1 --port 8000 Stack
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stack/.jac /opt/stack/storage /var/lib/stack-codex

[Install]
WantedBy=multi-user.target
