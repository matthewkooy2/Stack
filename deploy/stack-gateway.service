[Unit]
Description=Stack web workspace and public API gateway
After=stack-api.service

[Service]
User=stack
WorkingDirectory=/opt/stack
Environment=STACK_JAC_BIN=/usr/local/bin/jac
ExecStart=/opt/stack/scripts/jac run --no-serve scripts/gateway-service.jac
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stack/.jac

[Install]
WantedBy=multi-user.target
