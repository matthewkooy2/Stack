[Unit]
Description=Stack bounded live interview gateway
After=stack-api.service

[Service]
User=stack
WorkingDirectory=/opt/stack
EnvironmentFile=/etc/stack/worker.env
Environment=STACK_JAC_BIN=/usr/local/bin/jac
ExecStart=/opt/stack/scripts/jac run --no-serve scripts/voice-service.jac
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stack/.jac

[Install]
WantedBy=multi-user.target
