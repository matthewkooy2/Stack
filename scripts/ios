#!/bin/sh
set -eu
STACK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$STACK_ROOT"
STACK_CONFIGURATION=Debug
if [ "${STACK_BUILD_MODE:-}" = release ]; then STACK_CONFIGURATION=Release; fi
# Validate before compilation/prebuild or accessing signing identities.
node native/build-config.js --check .jac/mobile-rn
# Reuse the installed Apple Development certificate unless explicitly overridden.
STACK_TEAM=${STACK_TEAM:-$(security find-certificate -c 'Apple Development' -p | openssl x509 -noout -subject | sed -n 's/.*OU=\([^,/]*\).*/\1/p' | tr -d ' ')}
if [ -z "$STACK_TEAM" ]; then
  echo 'Set STACK_TEAM to your Xcode signing team ID.' >&2
  exit 1
fi
./scripts/jac run --no-serve scripts/compile-mobile.jac
cp native/app.config.js native/build-config.js .jac/mobile-rn/
# Synchronize ATS and APNs entitlements even when reusing a development workspace.
(cd .jac/mobile-rn && node node_modules/expo/bin/cli prebuild --platform ios --no-install)
LANG=en_US.UTF-8 pod install --project-directory=.jac/mobile-rn/ios --deployment
xcodebuild -workspace .jac/mobile-rn/ios/Stack.xcworkspace -scheme Stack -configuration "$STACK_CONFIGURATION" \
  -destination 'generic/platform=iOS' -derivedDataPath .jac/xcode-device \
  -allowProvisioningUpdates DEVELOPMENT_TEAM="$STACK_TEAM" CODE_SIGN_STYLE=Automatic
if [ "$STACK_CONFIGURATION" = Release ] && [ ! -s .jac/xcode-device/Build/Products/Release-iphoneos/Stack.app/main.jsbundle ]; then
  echo 'Release is missing its embedded JavaScript bundle. Do not install; check the Xcode bundle phase.' >&2
  exit 1
fi
if [ -n "${STACK_DEVICE:-}" ]; then
  xcrun devicectl device install app --device "$STACK_DEVICE" ".jac/xcode-device/Build/Products/$STACK_CONFIGURATION-iphoneos/Stack.app"
  xcrun devicectl device process launch --device "$STACK_DEVICE" com.matthewkooy.stack
else
  open -a Xcode .jac/mobile-rn/ios/Stack.xcworkspace
  echo "Built $STACK_CONFIGURATION. Install the app on your connected iPhone; set STACK_DEVICE to install and launch directly."
  if [ "$STACK_CONFIGURATION" = Debug ]; then echo 'Keep scripts/dev running for Debug.'; fi
fi
