#!/bin/sh
set -eu
STACK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export JAC_CACHE_HOME="${STACK_JAC_CACHE_HOME:-$STACK_ROOT/.jac/tool-cache}"
# A Unix socket cannot use the long worktree path. Keep runtime/test temporary
# output beside the common Git directory, on the same disk as the repository.
STACK_COMMON_GIT=$(git -C "$STACK_ROOT" rev-parse --path-format=absolute --git-common-dir)
STACK_TEMP_PARENT=$(CDPATH= cd -- "$STACK_COMMON_GIT/.." && pwd)
export TMPDIR="${STACK_TMP_DIR:-$STACK_TEMP_PARENT/.jac-tmp}"
mkdir -p "$TMPDIR"
# This Mac also has a newer development Jac on PATH. Prefer Stack's installed
# project version; an explicit override still wins.
STACK_PINNED_JAC="$STACK_TEMP_PARENT/../.tools/jac/0.37.21/jac"
if [ -z "${STACK_JAC_BIN:-}" ] && [ -x "$STACK_PINNED_JAC" ]; then
    STACK_JAC_BIN="$STACK_PINNED_JAC"
fi
cd "$STACK_ROOT"
exec "${STACK_JAC_BIN:-$HOME/.local/bin/jac}" "$@"
