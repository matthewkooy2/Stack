#!/bin/sh
set -eu
STACK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export JAC_CACHE_HOME="${STACK_JAC_CACHE_HOME:-$STACK_ROOT/.jac/tool-cache}"
export PATH="$STACK_ROOT/.jac/tools/bin:$PATH"
if [ -d "$STACK_ROOT/.jac/tools/postgres" ]; then
    export JAC_PG_DIST="$STACK_ROOT/.jac/tools/postgres"
    export JAC_PG_VERSION="18.6.0"
fi
if [ -z "${STACK_TMP_DIR:-}" ]; then
    STACK_TMP_DIR=$(python3 -c 'import sys; from pathlib import Path; sys.path.insert(0, sys.argv[1]+"/scripts"); import bootstrap; print(bootstrap.temporary_directory(Path(sys.argv[1])))' "$STACK_ROOT")
fi
export TMPDIR="$STACK_TMP_DIR"
mkdir -p "$TMPDIR"
if [ -z "${STACK_JAC_BIN:-}" ]; then
    if [ -x "$STACK_ROOT/.jac/tools/bin/jac" ]; then
        STACK_JAC_BIN="$STACK_ROOT/.jac/tools/bin/jac"
    elif [ "$(uname -s)" = Darwin ]; then
        STACK_JAC_BIN=$(command -v jac || true)
    else
        echo 'Run make setup to provision the pinned project Jac compiler.' >&2
        exit 1
    fi
fi
if [ -z "$STACK_JAC_BIN" ]; then
    echo 'Install Jac 0.37.21 for the optional Mac/iOS path.' >&2
    exit 1
fi
cd "$STACK_ROOT"
exec "$STACK_JAC_BIN" "$@"
